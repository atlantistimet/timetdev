{
  "expo": {
    "name": "Timeet",
    "slug": "timeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-video",
      [
        "expo-image-picker",
        { "photosPermission": "Timeet usa le tue foto e i tuoi video per servizi, post e anteprime." }
      ]
    ],
    "scheme": "timeet",
    "experiments": {
      "typedRoutes": true
    }
  }
}
